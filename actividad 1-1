#include <iostream>
using namespace std
class Persona {
private:
    string nombre;  // Encapsulado: no se puede acceder directamente
public:
    void setNombre(string n) {
        nombre = n;
    }
    void mostrarNombre() {
        cout << "Nombre: " << nombre << endl;
    }
};
int main() {
    Persona p;
    p.setNombre("Carlos");
    p.mostrarNombre();
    return 0;
}
