#include <iostream>
#include <string>
using namespace std;
class DispositivoElectronico {
public:
    virtual void encender() = 0;
    virtual void apagar() = 0;
    virtual ~DispositivoElectronico() {}
};
class Television : public DispositivoElectronico {
private:
    int volumen;
    int canal;
public:
    Television() : volumen(10), canal(1) {}
    void encender() override {
        cout << "La televisión está encendida.\n";
    }
    void apagar() override {
        cout << "La televisión se ha apagado.\n";
    }
    void cambiarVolumen(int nuevoVolumen) {
        if (nuevoVolumen >= 0 && nuevoVolumen <= 100) {
            volumen = nuevoVolumen;
            cout << "Volumen ajustado a: " << volumen << "\n";
        } else {
            cout << "Error: Nivel de volumen fuera de rango.\n";
        }
    }
    int obtenerVolumen() const {
        return volumen;
    }
};
int main() {
    DispositivoElectronico* miTv = new Television();
    miTv->encender();
    Television* tvConcreta = dynamic_cast<Television*>(miTv);
    if (tvConcreta) {
        tvConcreta->cambiarVolumen(20);
        cout << "Volumen actual: " << tvConcreta->obtenerVolumen() << "\n";
    }
    miTv->apagar();
    delete miTv;
    return 0;
}
