#include <iostream>
#include <string>
using namespace std;
class SistemaUniversidad {
public:
    // Responsabilidad 1: registrar estudiante
    void registrarEstudiante(string nombre) {
        cout << "Estudiante registrado: " << nombre << endl;
    }
    // Responsabilidad 2: calcular nota
    void calcularNota(double nota1, double nota2) {
        double promedio = (nota1 + nota2) / 2;
        cout << "Promedio: " << promedio << endl;
    }
    // Responsabilidad 3: guardar datos
    void guardarDatos() {
        cout << "Guardando datos del estudiante..." << endl;
    }
    // Responsabilidad 4: generar reporte
    void generarReporte() {
        cout << "Generando reporte del estudiante..." << endl;
    }
    // Responsabilidad 5: enviar correo
    void enviarCorreo() {
        cout << "Enviando correo al estudiante..." << endl;
    }
};
int main() {
    SistemaUniversidad sistema;
    sistema.registrarEstudiante("Anthony");
    sistema.calcularNota(15, 18);
    sistema.guardarDatos();
    sistema.generarReporte();
    sistema.enviarCorreo();
    return 0;
}
