#include <iostream>
using namespace std;
// Clase padre
class Padre {
private:
    void metodoPrivado1() {
        cout << "Metodo privado 1 de la clase Padre" << endl;
    }
    void metodoPrivado2() {
        cout << "Metodo privado 2 de la clase Padre" << endl;
    }
public:
    void mostrar() {
        cout << "Metodo publico de la clase Padre" << endl;
    }
};
// Clase hija
class Hija : public Padre {
public:
    void probarAcceso() {
        // Estos métodos NO se pueden utilizar directamente
        // porque son privados en la clase Padre.
        // metodoPrivado1(); // ERROR
        // metodoPrivado2(); // ERROR
        cout << "La clase Hija no puede acceder directamente ";
        cout << "a los metodos privados del Padre." << endl;
        // Este método sí se puede utilizar
        mostrar();
    }
};
int main() {
    Hija objeto;
    cout << "PRUEBA DE ACCESO" << endl;
    cout << "-----------------" << endl;
    objeto.probarAcceso();
    return 0;
}
