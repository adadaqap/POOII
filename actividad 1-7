#include <iostream>
using namespace std;
class Persona {
private:
    string nombre;
    int edad;
public:
    void setNombre(string n) {
        nombre = n;
    }
    string getNombre() {
        return nombre;
    }
    void setEdad(int e) {
        edad = e;
    }
    int getEdad() {
        return edad;
    }
};
int main() {
    Persona p;
    p.setNombre("Sandro");
    p.setEdad(19);
    cout << "Nombre: " << p.getNombre() << endl;
    cout << "Edad: " << p.getEdad() << endl;
    return 0;
}
