#include <iostream>
#include <string>
using namespace std;
// Responsabilidad: manejar los datos del estudiante
class Estudiante {
private:
    string nombre;
public:
    Estudiante(string n) {
        nombre = n;
    }
    void mostrarNombre() {
        cout << "Estudiante: " << nombre << endl;
    }
};
// Responsabilidad: calcular las notas
class Notas {
public:
    void calcularPromedio(double nota1, double nota2) {
        double promedio = (nota1 + nota2) / 2;
        cout << "Promedio: " << promedio << endl;
    }
};
// Responsabilidad: guardar datos
class BaseDatos {
public:
    void guardarDatos() {
        cout << "Guardando datos del estudiante..." << endl;
    }
};
// Responsabilidad: generar reportes
class Reporte {
public:
    void generarReporte() {
        cout << "Generando reporte del estudiante..." << endl;
    }
};
// Responsabilidad: enviar correos
class Correo {
public:
    void enviarCorreo() {
        cout << "Enviando correo al estudiante..." << endl;
    }
};
int main() {
    Estudiante estudiante("Anthony");
    Notas notas;
    BaseDatos baseDatos;
    Reporte reporte;
    Correo correo;
    estudiante.mostrarNombre();
    notas.calcularPromedio(15, 18);
    baseDatos.guardarDatos();
    reporte.generarReporte();
    correo.enviarCorreo();
    return 0;
}
