#include <iostream>
using namespace std;
class Animal {
public:
    virtual void sonido() {
        cout << "El animal hace un sonido" << endl;
    }
};
class Perro : public Animal {
public:
    void sonido() {
        cout << "El perro ladra" << endl;
    }
};
class Gato : public Animal {
public:
    void sonido() {
        cout << "El gato maulla" << endl;
    }
};
int main() {
    Animal* animal;
    Perro perro;
    Gato gato;
    animal = &perro;
    animal->sonido();
    animal = &gato;
    animal->sonido();
    return 0;
}
