#include <iostream>
using namespace std;
class Estudiante {
private:
    string nombre;
    int edad;
public:
    // Constructor por defecto
    Estudiante() {
        nombre = "Sin nombre";
        edad = 0;
    }
    // Constructor con un parámetro
    Estudiante(string n) {
        nombre = n;
        edad = 18;
    }
    // Constructor con dos parámetros
    Estudiante(string n, int e) {
        nombre = n;
        edad = e;
    }
    void mostrar() {
        cout << "Nombre: " << nombre << ", Edad: " << edad << endl;
    }
};
int main() {
    Estudiante e1;              // Constructor por defecto
    Estudiante e2("Juan");      // Constructor con un parámetro
    Estudiante e3("Pedro", 20); // Constructor con dos parámetros
    e1.mostrar();
    e2.mostrar();
    e3.mostrar();
    return 0;
}
