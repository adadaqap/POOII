#include <iostream>
using namespace std;
class Persona {
public:
    // Constructor
    Persona() {
        cout << "Constructor ejecutado" << endl;
    }
    // Destructor
    ~Persona() {
        cout << "Destructor ejecutado" << endl;
    }
};
int main() {
    Persona p;
    cout << "El objeto esta funcionando" << endl;
    p.~Persona();  // Llamada explícita al destructor
    return 0;
}
